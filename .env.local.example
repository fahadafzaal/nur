# ---------------------------------------------------------------------
# NUR — environment
#
# Copy this file to `.env.local` and fill in the two values.
# `.env.local` is gitignored and must never be committed.
#
# Supabase Dashboard → your project → Project Settings → Data API
#   Project URL  →  NEXT_PUBLIC_SUPABASE_URL
#   anon public  →  NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Both are safe in the browser: the anon key only grants what Row Level
# Security allows. The service_role key is NOT here on purpose — it
# bypasses RLS entirely and is only added server-side in M8 for the
# Stripe webhook.
# ---------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
