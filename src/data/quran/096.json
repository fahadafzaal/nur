{"number":96,"arabic":"سُورَةُ العَلَقِ","name":"Al-Alaq","meaning":"The Clot","ayahs":[{"n":1,"g":6107,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","en":"Recite in the name of your Lord who created -","juz":30,"page":597,"sajda":false},{"n":2,"g":6108,"ar":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","en":"Created man from a clinging substance.","juz":30,"page":597,"sajda":false},{"n":3,"g":6109,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","en":"Recite, and your Lord is the most Generous -","juz":30,"page":597,"sajda":false},{"n":4,"g":6110,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","en":"Who taught by the pen -","juz":30,"page":597,"sajda":false},{"n":5,"g":6111,"ar":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","en":"Taught man that which he knew not.","juz":30,"page":597,"sajda":false},{"n":6,"g":6112,"ar":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","en":"No! [But] indeed, man transgresses","juz":30,"page":597,"sajda":false},{"n":7,"g":6113,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","en":"Because he sees himself self-sufficient.","juz":30,"page":597,"sajda":false},{"n":8,"g":6114,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","en":"Indeed, to your Lord is the return.","juz":30,"page":597,"sajda":false},{"n":9,"g":6115,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","en":"Have you seen the one who forbids","juz":30,"page":597,"sajda":false},{"n":10,"g":6116,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","en":"A servant when he prays?","juz":30,"page":597,"sajda":false},{"n":11,"g":6117,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","en":"Have you seen if he is upon guidance","juz":30,"page":597,"sajda":false},{"n":12,"g":6118,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","en":"Or enjoins righteousness?","juz":30,"page":597,"sajda":false},{"n":13,"g":6119,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","en":"Have you seen if he denies and turns away -","juz":30,"page":597,"sajda":false},{"n":14,"g":6120,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","en":"Does he not know that Allah sees?","juz":30,"page":597,"sajda":false},{"n":15,"g":6121,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","en":"No! If he does not desist, We will surely drag him by the forelock -","juz":30,"page":597,"sajda":false},{"n":16,"g":6122,"ar":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","en":"A lying, sinning forelock.","juz":30,"page":597,"sajda":false},{"n":17,"g":6123,"ar":"فَلْيَدْعُ نَادِيَهُۥ","en":"Then let him call his associates;","juz":30,"page":597,"sajda":false},{"n":18,"g":6124,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","en":"We will call the angels of Hell.","juz":30,"page":597,"sajda":false},{"n":19,"g":6125,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","en":"No! Do not obey him. But prostrate and draw near [to Allah].","juz":30,"page":597,"sajda":true}],"revelation":"Meccan"}