{"number":112,"arabic":"سُورَةُ الإِخۡلَاصِ","name":"Al-Ikhlaas","meaning":"Sincerity","ayahs":[{"n":1,"g":6222,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,","juz":30,"page":604,"sajda":false},{"n":2,"g":6223,"ar":"ٱللَّهُ ٱلصَّمَدُ","en":"Allah, the Eternal Refuge.","juz":30,"page":604,"sajda":false},{"n":3,"g":6224,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","juz":30,"page":604,"sajda":false},{"n":4,"g":6225,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","juz":30,"page":604,"sajda":false}],"revelation":"Meccan"}