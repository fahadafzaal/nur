{"number":114,"arabic":"سُورَةُ النَّاسِ","name":"An-Naas","meaning":"Mankind","ayahs":[{"n":1,"g":6231,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","en":"Say, \"I seek refuge in the Lord of mankind,","juz":30,"page":604,"sajda":false},{"n":2,"g":6232,"ar":"مَلِكِ ٱلنَّاسِ","en":"The Sovereign of mankind.","juz":30,"page":604,"sajda":false},{"n":3,"g":6233,"ar":"إِلَٰهِ ٱلنَّاسِ","en":"The God of mankind,","juz":30,"page":604,"sajda":false},{"n":4,"g":6234,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","en":"From the evil of the retreating whisperer -","juz":30,"page":604,"sajda":false},{"n":5,"g":6235,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","en":"Who whispers [evil] into the breasts of mankind -","juz":30,"page":604,"sajda":false},{"n":6,"g":6236,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","en":"From among the jinn and mankind.\"","juz":30,"page":604,"sajda":false}],"revelation":"Meccan"}